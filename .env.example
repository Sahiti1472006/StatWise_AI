# MODEL_API_KEY: Official Meta Model API Key for Muse Spark series.
# When provided, StatWise AI connects directly to https://api.meta.ai/v1 using the OpenAI-compatible SDK.
# If not configured, StatWise AI operates in a clearly marked Demo Mode.
MODEL_API_KEY=""

# Meta Model API Configuration
META_BASE_URL="https://api.meta.ai/v1"
MODEL_ID="muse-spark-1.3"

# GEMINI_API_KEY: Required by AI Studio environment
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

